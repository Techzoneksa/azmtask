# ---------------------------------------------------------------------------
# نظام إدارة الفنادق — متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم. لا تضع .env في المستودع.
# ---------------------------------------------------------------------------

# مفتاح توقيع جلسات الدخول — إجباري، 32 حرفًا على الأقل.
# ولّد قيمة عشوائية بالأمر:  openssl rand -base64 48
AUTH_SECRET=

# بيئة التشغيل: development أو production
NODE_ENV=production

# المنفذ الذي يستمع عليه التطبيق (هوستنجر يمرره تلقائيًا)
PORT=3000

# ---------------------------------------------------------------------------
# قاعدة البيانات — تُستخدم ابتداءً من المرحلة 2
# صيغة MySQL:  mysql://user:password@host:3306/database
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# حسابات العرض التجريبي (اختياري)
# DEMO_PASSWORD_HASH: ناتج bcrypt لكلمة مرور حسابات العرض.
# ولّده بالأمر:  node -e "console.log(require('bcryptjs').hashSync('YourPassword',10))"
# DEMO_PASSWORD_HINT: النص المعروض في شاشة الدخول. اتركه فارغًا في الإنتاج.
# ---------------------------------------------------------------------------
DEMO_PASSWORD_HASH=
DEMO_PASSWORD_HINT=
