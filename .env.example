# ---------------------------------------------------------------------------
# نظام إدارة الفنادق — متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم. لا تضع .env في المستودع.
# ---------------------------------------------------------------------------

# --- إجباري --------------------------------------------------------------

# مفتاح توقيع جلسات الدخول — 32 حرفًا على الأقل.
# ولّد قيمة عشوائية:  openssl rand -base64 48
AUTH_SECRET=

# سلسلة اتصال MySQL. في هوستنجر تجدها في hPanel → Databases → MySQL.
# الصيغة: mysql://user:password@host:3306/database
DATABASE_URL=

# --- اختياري -------------------------------------------------------------

# المنفذ. هوستنجر يمرره تلقائيًا — لا تضبطه يدويًا.
# PORT=3000

# لا تضبط NODE_ENV=production كمتغير بيئة: يجعل npm يتخطى devDependencies
# ويكسر البناء. الأمر `next start` يضبطها بنفسه.

# حجم مجمّع اتصالات قاعدة البيانات. الافتراضي 5 — مناسب لخطط الاستضافة
# المشتركة التي تحدّ الاتصالات المتزامنة. ارفعه على خادم مخصص فقط.
# DATABASE_POOL_SIZE=5

# قاعدة الظل التي يستخدمها `prisma migrate dev` أثناء التطوير فقط.
# غير مطلوبة في الإنتاج — `prisma migrate deploy` لا يستخدمها.
# SHADOW_DATABASE_URL=

# قاعدة الاختبارات. يجب أن ينتهي اسمها بـ nokhba_test وإلا رفضت الاختبارات العمل.
# TEST_DATABASE_URL=

# كلمة مرور الحسابات التي تنشئها البذرة. تُستخدم عند الإنشاء فقط —
# إعادة تشغيل البذرة لا تعيد تعيين كلمة مرور غُيّرت لاحقًا.
# SEED_PASSWORD=

# بريد حساب المدير الأولي الذي تنشئه بذرة النظام.
# SEED_ADMIN_EMAIL=

# يسمح بتشغيل db:demo-reset في بيئة NODE_ENV=production.
# اتركه غير مضبوط. اضبطه فقط إن كانت هذه بيئة عرض تعمل بوضع الإنتاج.
# ALLOW_DEMO_RESET=

# رمز اختياري لكشف سبب فشل الاتصال عبر /api/health?token=...
# اضبطه مؤقتًا حين تحتاج تشخيصًا ولا تملك وصولًا لسجل الخادم، ثم احذفه.
# بدونه تقول النقطة «غير متصل» فقط ولا تكشف السبب.
# HEALTH_DIAGNOSTIC_TOKEN=

# عند ضبطه تظهر قائمة حسابات العرض في شاشة الدخول.
# اتركه فارغًا في الإنتاج فتختفي القائمة تمامًا.
DEMO_PASSWORD_HINT=
