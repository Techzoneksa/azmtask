// ---------------------------------------------------------------------------
// Hotel Management System — relational foundation
//
// Conventions used throughout this schema:
//
//   Money      Decimal @db.Decimal(12, 2). Never a float. 12 digits total covers
//              amounts up to 9,999,999,999.99 SAR, far beyond any single record.
//
//   Business   DateTime @db.Date. A check-in date is a calendar date at the
//   dates      property, not an instant: "2026-08-20" means the same thing to
//              reception whatever timezone the browser is in.
//
//   Timestamps DateTime @db.DateTime(3) stored in UTC. These are instants —
//              when a payment was taken, when a task was completed.
//
//   Delete     Operational history (reservations, payments, invoices, charges,
//   behaviour  activity, stock movements) is never cascade-deleted. Parents use
//              Restrict so history cannot vanish; assignments that may legitimately
//              disappear (an employee leaving) use SetNull; pure join rows Cascade.
//
//   Derived    A few fields cache values derivable from child rows, for list-screen
//   fields     performance. Each is marked DERIVED with its canonical source and the
//              service that owns it. They are only ever written inside the same
//              transaction as the rows they summarise.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ===========================================================================
// PROPERTIES AND UNITS
// ===========================================================================

enum PropertyType {
  HOTEL
  SERVICED_APARTMENT
  RESORT
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

model Property {
  id        String       @id @default(cuid()) @db.VarChar(30)
  name      String       @db.VarChar(160)
  type      PropertyType
  city      String       @db.VarChar(80)
  address   String?      @db.VarChar(255)
  phone     String?      @db.VarChar(24)
  email     String?      @db.VarChar(160)
  /// Nullable and unique: MySQL permits repeated NULLs, so properties without a
  /// tax number coexist while a registered number can never be claimed twice.
  taxNumber String?      @unique @db.VarChar(40)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @db.DateTime(3)
  updatedAt DateTime     @updatedAt @db.DateTime(3)

  unitTypes           UnitType[]
  units               Unit[]
  reservations        Reservation[]
  reservationCharges  ReservationCharge[]
  payments            Payment[]
  invoices            Invoice[]
  housekeepingTasks   HousekeepingTask[]
  maintenanceRequests MaintenanceRequest[]
  employees           Employee[]
  expenses            Expense[]
  inventoryCategories InventoryCategory[]
  inventoryItems      InventoryItem[]
  inventoryMovements  InventoryTransaction[]
  outlets             Outlet[]
  unitBlocks          UnitBlock[]
  activityLogs        ActivityLog[]
  settings            SystemSetting[]

  @@index([status])
  @@map("properties")
}

model UnitType {
  id          String       @id @default(cuid()) @db.VarChar(30)
  propertyId  String       @db.VarChar(30)
  name        String       @db.VarChar(120)
  description String?      @db.Text
  capacity    Int          @default(2)
  /// Default nightly rate. A reservation copies its own nightlyRate at booking
  /// time, so later price changes never rewrite the history of existing stays.
  baseRate    Decimal      @db.Decimal(12, 2)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @db.DateTime(3)
  updatedAt   DateTime     @updatedAt @db.DateTime(3)

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  units        Unit[]
  reservations Reservation[]

  @@unique([propertyId, name])
  @@index([propertyId, status])
  @@map("unit_types")
}

enum UnitStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  CLEANING
  MAINTENANCE
  BLOCKED
}

enum HousekeepingStatus {
  CLEAN
  DIRTY
  CLEANING
  INSPECTED
}

/// Whether the unit can be sold at all, independent of who is in it right now.
enum UnitMaintenanceStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
}

model Unit {
  id         String @id @default(cuid()) @db.VarChar(30)
  propertyId String @db.VarChar(30)
  unitTypeId String @db.VarChar(30)
  unitNumber String @db.VarChar(20)
  floor      Int?

  /// DERIVED — canonical source is the set of reservations covering today plus the
  /// housekeeping and maintenance columns below. Owned by unitService.applyStatus,
  /// always written in the same transaction as the event that changed it
  /// (check-in, check-out, housekeeping completion, maintenance open/close).
  status             UnitStatus            @default(AVAILABLE)
  housekeepingStatus HousekeepingStatus    @default(CLEAN)
  maintenanceStatus  UnitMaintenanceStatus @default(OPERATIONAL)

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unitType            UnitType             @relation(fields: [unitTypeId], references: [id], onDelete: Restrict)
  reservations        Reservation[]
  housekeepingTasks   HousekeepingTask[]
  maintenanceRequests MaintenanceRequest[]
  blocks              UnitBlock[]

  /// Room 101 exists once per property. This is the constraint that makes the unit
  /// board trustworthy.
  @@unique([propertyId, unitNumber])
  @@index([propertyId, status])
  @@index([propertyId, housekeepingStatus])
  @@index([unitTypeId])
  @@map("units")
}

enum UnitBlockReason {
  RENOVATION
  DEEP_CLEANING
  STAFF_USE
  OWNER_USE
  LONG_TERM_MAINTENANCE
  SEASONAL_CLOSURE
  OTHER
}

/// Why a room is off the market, and for how long.
///
/// A status column alone answers "is it blocked" but never "why, since when, and
/// who decided". A front desk turning guests away needs all three, and a room that
/// has been out of service for a month with nobody able to say why is how inventory
/// quietly disappears. Blocks are therefore records with a history, not a flag:
/// ending one closes the row rather than erasing it.
model UnitBlock {
  id         String          @id @default(cuid()) @db.VarChar(30)
  propertyId String          @db.VarChar(30)
  unitId     String          @db.VarChar(30)
  reason     UnitBlockReason
  notes      String?         @db.Text

  /// Business dates, half-open like a stay: the room is unsellable from startDate
  /// up to but not including endDate. A null endDate means open-ended.
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  /// An active block is the one holding the room now; ending it sets endedAt and
  /// leaves the row in place as the record of what happened.
  active  Boolean   @default(true)
  endedAt DateTime? @db.DateTime(3)

  createdById String?  @db.VarChar(30)
  endedById   String?  @db.VarChar(30)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("UnitBlockCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  endedBy   User?    @relation("UnitBlockEndedBy", fields: [endedById], references: [id], onDelete: SetNull)

  /// Serves "is this room blocked right now" and the overlap check a new block runs.
  @@index([unitId, active, startDate])
  @@index([propertyId, active])
  @@map("unit_blocks")
}

// ===========================================================================
// GUESTS
// ===========================================================================

/// Open set so passports, national IDs and residency permits all fit without a
/// schema change when a new document type appears.
enum IdentificationType {
  NATIONAL_ID
  IQAMA
  PASSPORT
  GCC_ID
  OTHER
}

enum Gender {
  MALE
  FEMALE
}

model Guest {
  id                   String              @id @default(cuid()) @db.VarChar(30)
  fullName             String              @db.VarChar(160)
  nationality          String?             @db.VarChar(80)
  mobile               String?             @db.VarChar(24)
  email                String?             @db.VarChar(160)
  identificationType   IdentificationType?
  identificationNumber String?             @db.VarChar(40)
  dateOfBirth          DateTime?           @db.Date
  gender               Gender?
  notes                String?             @db.Text
  preferences          String?             @db.Text
  createdAt            DateTime            @default(now()) @db.DateTime(3)
  updatedAt            DateTime            @updatedAt @db.DateTime(3)

  reservations Reservation[]
  payments     Payment[]
  invoices     Invoice[]

  /// A document number is unique only within its own type — a passport and a
  /// national ID may legitimately share digits. Guests recorded without a document
  /// are unconstrained, because MySQL treats each NULL as distinct.
  @@unique([identificationType, identificationNumber])
  @@index([mobile])
  @@index([identificationNumber])
  @@index([fullName])
  @@map("guests")
}

// ===========================================================================
// RESERVATIONS
// ===========================================================================

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum ReservationSource {
  DIRECT
  WEBSITE
  PHONE
  WALK_IN
  CHANNEL
  CORPORATE
}

model Reservation {
  id                String            @id @default(cuid()) @db.VarChar(30)
  reservationNumber String            @unique @db.VarChar(24)
  propertyId        String            @db.VarChar(30)
  guestId           String            @db.VarChar(30)
  /// Nullable: a reservation may be taken against a unit type before a specific
  /// room is assigned. Only a reservation with a unit participates in collision
  /// checks.
  unitId            String?           @db.VarChar(30)
  unitTypeId        String            @db.VarChar(30)
  source            ReservationSource @default(DIRECT)

  /// Business dates. checkOutDate is exclusive: a stay of 20→22 occupies the
  /// nights of the 20th and 21st, and the room is sellable again on the 22nd.
  checkInDate  DateTime @db.Date
  checkOutDate DateTime @db.Date

  adults   Int @default(1)
  children Int @default(0)

  /// Rate agreed at booking time, copied from the unit type so later price
  /// changes cannot rewrite an existing stay.
  nightlyRate Decimal @db.Decimal(12, 2)

  /// DERIVED — canonical sources: subtotal = nightlyRate x nights;
  /// additionalCharges = SUM(reservation_charges.total);
  /// total = subtotal - discount + tax + additionalCharges;
  /// paidAmount = SUM(payments.amount); balance = total - paidAmount.
  /// All five are recomputed by reservationService.recalculateTotals inside the
  /// same transaction that inserts or removes a charge or payment. paymentStatus
  /// is set from the recomputed balance, never independently.
  subtotal          Decimal @default(0) @db.Decimal(12, 2)
  discount          Decimal @default(0) @db.Decimal(12, 2)
  tax               Decimal @default(0) @db.Decimal(12, 2)
  additionalCharges Decimal @default(0) @db.Decimal(12, 2)
  total             Decimal @default(0) @db.Decimal(12, 2)
  paidAmount        Decimal @default(0) @db.Decimal(12, 2)
  balance           Decimal @default(0) @db.Decimal(12, 2)

  status        ReservationStatus @default(PENDING)
  paymentStatus PaymentStatus     @default(UNPAID)

  specialRequests String?   @db.Text
  internalNotes   String?   @db.Text
  checkedInAt     DateTime? @db.DateTime(3)
  checkedOutAt    DateTime? @db.DateTime(3)
  cancelledAt     DateTime? @db.DateTime(3)
  cancelReason    String?   @db.VarChar(255)

  createdById String?  @db.VarChar(30)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  property  Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  guest     Guest     @relation(fields: [guestId], references: [id], onDelete: Restrict)
  unit      Unit?     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  unitType  UnitType  @relation(fields: [unitTypeId], references: [id], onDelete: Restrict)
  createdBy User?     @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  charges  ReservationCharge[]
  payments Payment[]
  invoices Invoice[]

  /// Serves the availability query directly:
  ///   unitId = ? AND status IN (blocking) AND checkInDate < ? AND checkOutDate > ?
  /// Equality on the first two columns, then a range on the dates.
  @@index([unitId, status, checkInDate, checkOutDate])
  /// Arrivals, departures and occupancy for a property on a given day.
  @@index([propertyId, status, checkInDate])
  @@index([propertyId, checkOutDate])
  @@index([guestId])
  @@index([unitTypeId])
  @@index([paymentStatus])
  @@map("reservations")
}

enum ChargeCategory {
  ROOM_SERVICE
  LAUNDRY
  RESTAURANT
  EXTRA_BED
  LATE_CHECKOUT
  TRANSPORTATION
  MINIBAR
  OTHER
}

/// One row per service actually rendered. The reservation keeps only the sum;
/// this table keeps the detail an invoice line and a dispute both need.
model ReservationCharge {
  id            String         @id @default(cuid()) @db.VarChar(30)
  reservationId String         @db.VarChar(30)
  propertyId    String         @db.VarChar(30)
  outletId      String?        @db.VarChar(30)
  category      ChargeCategory
  description   String         @db.VarChar(255)
  quantity      Decimal        @default(1) @db.Decimal(10, 2)
  unitPrice     Decimal        @db.Decimal(12, 2)
  tax           Decimal        @default(0) @db.Decimal(12, 2)
  total         Decimal        @db.Decimal(12, 2)
  chargedAt     DateTime       @default(now()) @db.DateTime(3)
  createdById   String?        @db.VarChar(30)
  createdAt     DateTime       @default(now()) @db.DateTime(3)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  outlet      Outlet?     @relation(fields: [outletId], references: [id], onDelete: SetNull)
  createdBy   User?       @relation("ChargeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([propertyId, chargedAt])
  @@index([outletId])
  @@map("reservation_charges")
}

// ===========================================================================
// MONEY IN AND OUT
// ===========================================================================

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

model Payment {
  id            String        @id @default(cuid()) @db.VarChar(30)
  paymentNumber String        @unique @db.VarChar(24)
  reservationId String        @db.VarChar(30)
  guestId       String        @db.VarChar(30)
  propertyId    String        @db.VarChar(30)
  /// Positive for a receipt, negative for a refund. The sign is what makes
  /// SUM(amount) the reservation's true paid amount.
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  reference     String?       @db.VarChar(120)
  notes         String?       @db.Text
  paymentDate   DateTime      @default(now()) @db.DateTime(3)
  createdById   String?       @db.VarChar(30)
  createdAt     DateTime      @default(now()) @db.DateTime(3)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  guest       Guest       @relation(fields: [guestId], references: [id], onDelete: Restrict)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  createdBy   User?       @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([propertyId, paymentDate])
  @@index([guestId])
  @@map("payments")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Invoice {
  id            String  @id @default(cuid()) @db.VarChar(30)
  invoiceNumber String  @unique @db.VarChar(24)
  propertyId    String  @db.VarChar(30)
  reservationId String  @db.VarChar(30)
  guestId       String  @db.VarChar(30)

  /// DERIVED — snapshot of the reservation's figures at issue time. Deliberately a
  /// copy, not a live join: an issued invoice must keep showing what the guest was
  /// handed, even after a later adjustment moves the reservation's totals.
  /// Owned by invoiceService.issue and invoiceService.applyPayment.
  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)
  paid     Decimal @default(0) @db.Decimal(12, 2)
  balance  Decimal @default(0) @db.Decimal(12, 2)

  status    InvoiceStatus @default(DRAFT)
  issueDate DateTime      @db.Date
  notes     String?       @db.Text
  createdAt DateTime      @default(now()) @db.DateTime(3)
  updatedAt DateTime      @updatedAt @db.DateTime(3)

  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  guest       Guest       @relation(fields: [guestId], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@index([propertyId, status])
  @@index([guestId])
  @@index([issueDate])
  @@map("invoices")
}

enum ExpenseCategory {
  MAINTENANCE
  UTILITIES
  SUPPLIES
  CLEANING
  SALARIES
  MARKETING
  OTHER
}

model Expense {
  id            String          @id @default(cuid()) @db.VarChar(30)
  propertyId    String          @db.VarChar(30)
  expenseNumber String          @unique @db.VarChar(24)
  category      ExpenseCategory
  amount        Decimal         @db.Decimal(12, 2)
  date          DateTime        @db.Date
  paymentMethod PaymentMethod   @default(CASH)
  description   String?         @db.Text
  attachmentUrl String?         @db.VarChar(500)
  createdById   String?         @db.VarChar(30)
  createdAt     DateTime        @default(now()) @db.DateTime(3)
  updatedAt     DateTime        @updatedAt @db.DateTime(3)

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([propertyId, date])
  @@index([propertyId, category])
  @@map("expenses")
}

// ===========================================================================
// OPERATIONS — HOUSEKEEPING AND MAINTENANCE
// ===========================================================================

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum HousekeepingTaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum HousekeepingTaskType {
  CHECKOUT_CLEANING
  STAY_OVER
  DEEP_CLEANING
  INSPECTION
  TURNDOWN
  OTHER
}

model HousekeepingTask {
  id                 String                 @id @default(cuid()) @db.VarChar(30)
  propertyId         String                 @db.VarChar(30)
  unitId             String                 @db.VarChar(30)
  assignedEmployeeId String?                @db.VarChar(30)
  taskType           HousekeepingTaskType   @default(CHECKOUT_CLEANING)
  status             HousekeepingTaskStatus @default(PENDING)
  priority           TaskPriority           @default(NORMAL)
  notes              String?                @db.Text
  startedAt          DateTime?              @db.DateTime(3)
  completedAt        DateTime?              @db.DateTime(3)
  createdAt          DateTime               @default(now()) @db.DateTime(3)
  updatedAt          DateTime               @updatedAt @db.DateTime(3)

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit     Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  /// SetNull, not Restrict: an employee may leave, and the task record should
  /// survive them rather than block their removal.
  assignee Employee? @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)

  @@index([unitId, status])
  @@index([propertyId, status])
  @@index([assignedEmployeeId, status])
  @@map("housekeeping_tasks")
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model MaintenanceRequest {
  id                 String            @id @default(cuid()) @db.VarChar(30)
  propertyId         String            @db.VarChar(30)
  unitId             String?           @db.VarChar(30)
  assignedEmployeeId String?           @db.VarChar(30)
  issue              String            @db.VarChar(255)
  priority           TaskPriority      @default(NORMAL)
  status             MaintenanceStatus @default(OPEN)
  notes              String?           @db.Text
  openedAt           DateTime          @default(now()) @db.DateTime(3)
  completedAt        DateTime?         @db.DateTime(3)
  createdAt          DateTime          @default(now()) @db.DateTime(3)
  updatedAt          DateTime          @updatedAt @db.DateTime(3)

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  /// Nullable: not every fault belongs to a room — a lobby lift does not.
  unit     Unit?     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  assignee Employee? @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)

  @@index([unitId, status])
  @@index([propertyId, status])
  @@index([assignedEmployeeId, status])
  @@map("maintenance_requests")
}

// ===========================================================================
// PEOPLE — EMPLOYEES AND SYSTEM USERS
// ===========================================================================

enum Department {
  MANAGEMENT
  FRONT_OFFICE
  HOUSEKEEPING
  MAINTENANCE
  FINANCE
  FOOD_AND_BEVERAGE
  SECURITY
  OTHER
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

/// A person who works at the property. Most employees never sign in — a room
/// attendant is assigned tasks without ever holding an account.
model Employee {
  id               String           @id @default(cuid()) @db.VarChar(30)
  propertyId       String           @db.VarChar(30)
  name             String           @db.VarChar(160)
  mobile           String?          @db.VarChar(24)
  email            String?          @db.VarChar(160)
  department       Department       @default(OTHER)
  position         String?          @db.VarChar(120)
  employmentStatus EmploymentStatus @default(ACTIVE)
  createdAt        DateTime         @default(now()) @db.DateTime(3)
  updatedAt        DateTime         @updatedAt @db.DateTime(3)

  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  user                User?
  housekeepingTasks   HousekeepingTask[]
  maintenanceRequests MaintenanceRequest[]

  @@index([propertyId, employmentStatus])
  @@index([propertyId, department])
  @@map("employees")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// A login. Separate from Employee on purpose: an integration account or an owner
/// who is not on the payroll still needs access, and most staff never need a login.
model User {
  id           String     @id @default(cuid()) @db.VarChar(30)
  /// Optional and unique — at most one login per employee.
  employeeId   String?    @unique @db.VarChar(30)
  name         String     @db.VarChar(160)
  email        String     @unique @db.VarChar(160)
  /// bcrypt hash. Plaintext never reaches this column, and this column never
  /// leaves the server.
  passwordHash String     @db.VarChar(72)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @db.DateTime(3)
  createdAt    DateTime   @default(now()) @db.DateTime(3)
  updatedAt    DateTime   @updatedAt @db.DateTime(3)

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  roles    UserRole[]

  activityLogs        ActivityLog[]
  createdReservations Reservation[]         @relation("ReservationCreatedBy")
  createdPayments     Payment[]             @relation("PaymentCreatedBy")
  createdCharges      ReservationCharge[]   @relation("ChargeCreatedBy")
  createdExpenses     Expense[]             @relation("ExpenseCreatedBy")
  createdStockMoves   InventoryTransaction[] @relation("StockMoveCreatedBy")
  createdUnitBlocks   UnitBlock[]            @relation("UnitBlockCreatedBy")
  endedUnitBlocks     UnitBlock[]            @relation("UnitBlockEndedBy")

  @@index([status])
  @@map("users")
}

// ===========================================================================
// AUTHORIZATION — ROLES AND PERMISSIONS
// ===========================================================================

/// One row per permission key, e.g. "reservations.checkin". Feature code checks
/// these keys; it never checks a role name.
model Permission {
  id          String   @id @default(cuid()) @db.VarChar(30)
  key         String   @unique @db.VarChar(60)
  module      String   @db.VarChar(40)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.DateTime(3)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model Role {
  id          String   @id @default(cuid()) @db.VarChar(30)
  key         String   @unique @db.VarChar(40)
  name        String   @db.VarChar(120)
  description String   @db.VarChar(255)
  /// System roles ship with the product. Their key may not change and they may not
  /// be deleted, but an administrator may still edit which permissions they grant.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Join rows carry no history worth keeping, so they cascade with their parents.
model RolePermission {
  roleId       String   @db.VarChar(30)
  permissionId String   @db.VarChar(30)
  createdAt    DateTime @default(now()) @db.DateTime(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @db.VarChar(30)
  roleId    String   @db.VarChar(30)
  createdAt DateTime @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ===========================================================================
// AUDIT
// ===========================================================================

model ActivityLog {
  id         String  @id @default(cuid()) @db.VarChar(30)
  propertyId String? @db.VarChar(30)
  userId     String? @db.VarChar(30)

  /// Snapshots taken at write time. An audit trail that has to join to users to
  /// render is an audit trail that changes when someone is renamed or removed —
  /// so the acting identity is frozen into the row itself.
  userName  String @db.VarChar(160)
  userEmail String @db.VarChar(160)
  userRoles String @db.VarChar(255)

  module      String  @db.VarChar(40)
  action      String  @db.VarChar(60)
  entityType  String  @db.VarChar(40)
  entityId    String? @db.VarChar(30)
  description String  @db.VarChar(500)
  /// Small JSON payload of what changed. Never credentials, tokens or hashes.
  metadata    Json?
  ipAddress   String? @db.VarChar(45)

  createdAt DateTime @default(now()) @db.DateTime(3)

  /// SetNull keeps the log row when a user is removed; the snapshot columns above
  /// mean the entry still reads correctly afterwards.
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([propertyId, createdAt])
  @@index([module, action])
  @@map("activity_logs")
}

// ===========================================================================
// INVENTORY
// ===========================================================================

model InventoryCategory {
  id         String       @id @default(cuid()) @db.VarChar(30)
  propertyId String       @db.VarChar(30)
  name       String       @db.VarChar(120)
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @db.DateTime(3)
  updatedAt  DateTime     @updatedAt @db.DateTime(3)

  property Property        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  items    InventoryItem[]

  @@unique([propertyId, name])
  @@map("inventory_categories")
}

model InventoryItem {
  id         String  @id @default(cuid()) @db.VarChar(30)
  propertyId String  @db.VarChar(30)
  categoryId String  @db.VarChar(30)
  name       String  @db.VarChar(160)
  sku        String? @db.VarChar(60)

  /// DERIVED — canonical source is SUM of inventory_transactions.quantity for the
  /// item. Owned by inventoryService.recordMovement, which inserts the movement
  /// and updates this column in one transaction. Never written from a client
  /// supplied figure.
  quantity        Decimal @default(0) @db.Decimal(12, 2)
  minimumQuantity Decimal @default(0) @db.Decimal(12, 2)

  unit      String       @default("PCS") @db.VarChar(20)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @db.DateTime(3)
  updatedAt DateTime     @updatedAt @db.DateTime(3)

  property  Property               @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  category  InventoryCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  movements InventoryTransaction[]

  @@unique([propertyId, sku])
  @@index([propertyId, status])
  @@index([categoryId])
  @@map("inventory_items")
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

model InventoryTransaction {
  id         String            @id @default(cuid()) @db.VarChar(30)
  itemId     String            @db.VarChar(30)
  propertyId String            @db.VarChar(30)
  type       StockMovementType
  /// Signed: positive adds to stock, negative removes. STOCK_OUT rows are stored
  /// negative so SUM(quantity) is the item's true quantity with no case analysis.
  quantity   Decimal           @db.Decimal(12, 2)
  reference  String?           @db.VarChar(120)
  notes      String?           @db.Text
  createdById String?          @db.VarChar(30)
  createdAt  DateTime          @default(now()) @db.DateTime(3)

  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  property  Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  createdBy User?         @relation("StockMoveCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
  @@index([propertyId, createdAt])
  @@map("inventory_transactions")
}

// ===========================================================================
// SERVICE OUTLETS
// ===========================================================================

enum OutletType {
  RESTAURANT
  CAFE
  LAUNDRY
  ROOM_SERVICE
  SPA
  TRANSPORT
  OTHER
}

/// Where a guest charge originates. Enough structure for Stage 14 to attach
/// charges correctly; no POS behaviour is implied.
model Outlet {
  id         String       @id @default(cuid()) @db.VarChar(30)
  propertyId String       @db.VarChar(30)
  name       String       @db.VarChar(120)
  type       OutletType
  location   String?      @db.VarChar(160)
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @db.DateTime(3)
  updatedAt  DateTime     @updatedAt @db.DateTime(3)

  property Property            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  charges  ReservationCharge[]

  @@unique([propertyId, name])
  @@index([propertyId, status])
  @@map("outlets")
}

// ===========================================================================
// SYSTEM CONFIGURATION
// ===========================================================================

/// Key/value configuration. A null propertyId means the setting is global.
model SystemSetting {
  id         String   @id @default(cuid()) @db.VarChar(30)
  propertyId String?  @db.VarChar(30)
  key        String   @db.VarChar(80)
  value      String   @db.Text
  updatedAt  DateTime @updatedAt @db.DateTime(3)

  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, key])
  @@map("system_settings")
}
